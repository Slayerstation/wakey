# Dockerfile.debian
FROM debian:stable-slim

# Install build tools and necessary libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    wget \
    net-tools \
    iputils-ping \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy the source and tests into the image
COPY wakey19.c .
COPY tests/ ./tests/

# Compile the application
RUN gcc -o wakey wakey19.c -lpthread

# Optionally compile unit tests (if you want to run them inside the container)
RUN gcc -DUNIT_TEST -o test_unit tests/test_unit.c -lpthread

# Run unit tests during build; if they fail, the build stops.
RUN ./test_unit

# Define the default command.
CMD ["./wakey"]
