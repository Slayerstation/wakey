# Dockerfile.windows
FROM mcr.microsoft.com/windows/servercore:ltsc2019

# Install Chocolatey using a single RUN command via JSON-array syntax.
RUN ["powershell", "-Command", "Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://chocolatey.org/install.ps1'))"]

# Install MinGW for gcc.
RUN ["powershell", "-Command", "choco install mingw -y"]

# Add MinGW to the PATH (adjust the path if necessary).
ENV PATH="C:\\tools\\mingw64\\bin;${PATH}"
WORKDIR C:/src

# Copy the source code and test files into the container.
COPY wakey.c .
COPY tests/ tests/

# Compile the application using gcc.
RUN ["powershell", "-Command", "gcc -o wakey.exe wakey.c -lpthread"]

# Run the application.
CMD ["cmd", "/C", "wakey.exe"]
